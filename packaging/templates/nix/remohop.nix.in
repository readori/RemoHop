# Nix expression for RemoHop, generated by scripts/gen-manifests.sh. It installs the
# prebuilt release binaries (a static Go program on Linux; a signed, notarized universal
# binary on macOS, so nothing may patch or strip it). Use it with:
#   nix-build -E 'with import <nixpkgs> {}; callPackage ./remohop.nix {}'
#   nix profile install --impure --expr 'with import <nixpkgs> {}; callPackage ./remohop.nix {}'
# A from-source buildGoModule package (vendorHash needed) is the better fit for nixpkgs
# itself once the repository is public.
{ lib, stdenvNoCC, fetchurl }:
let
  version = "@VERSION_NOV@";
  base = "https://github.com/@REPO@/releases/download/@TAG@";
  sources = {
    x86_64-linux = { url = "${base}/remohop_linux_amd64.tar.gz"; sha256 = "@SHA_LINUX_AMD64@"; };
    aarch64-linux = { url = "${base}/remohop_linux_arm64.tar.gz"; sha256 = "@SHA_LINUX_ARM64@"; };
    x86_64-darwin = { url = "${base}/remohop_darwin_universal.tar.gz"; sha256 = "@SHA_DARWIN_UNIVERSAL@"; };
    aarch64-darwin = { url = "${base}/remohop_darwin_universal.tar.gz"; sha256 = "@SHA_DARWIN_UNIVERSAL@"; };
  };
  src = sources.${stdenvNoCC.hostPlatform.system}
    or (throw "remohop: unsupported system ${stdenvNoCC.hostPlatform.system}");
in
stdenvNoCC.mkDerivation {
  pname = "remohop";
  inherit version;
  src = fetchurl { inherit (src) url sha256; };
  sourceRoot = ".";
  dontConfigure = true;
  dontBuild = true;
  dontFixup = true; # no strip/patchelf/codesign changes to a signed or static binary
  installPhase = ''
    runHook preInstall
    install -Dm755 remohop $out/bin/remohop
    install -Dm644 LICENSE $out/share/doc/remohop/LICENSE
    install -Dm644 NOTICE $out/share/doc/remohop/NOTICE
    install -Dm644 THIRD_PARTY_LICENSES.txt $out/share/doc/remohop/THIRD_PARTY_LICENSES.txt
    runHook postInstall
  '';
  meta = {
    description = "Lightweight peer-to-peer remote control over an end-to-end encrypted session";
    homepage = "https://github.com/@REPO@";
    license = lib.licenses.agpl3Only;
    mainProgram = "remohop";
    platforms = builtins.attrNames sources;
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
  };
}
