# Maintainer: REPLACE_ME_MAINTAINER
# Generated by scripts/gen-manifests.sh. Install the prebuilt, signed release binaries.
# Publish: git clone ssh://aur@aur.archlinux.org/remohop-bin.git, copy PKGBUILD and
# .SRCINFO in (regenerate the latter with `makepkg --printsrcinfo > .SRCINFO` on Arch).
pkgname=remohop-bin
pkgver=@VERSION_AUR@
pkgrel=1
pkgdesc='Lightweight peer-to-peer remote control over an end-to-end encrypted session (remohop)'
arch=('x86_64' 'aarch64')
url='https://github.com/@REPO@'
license=('AGPL-3.0-only')
provides=('remohop')
conflicts=('remohop')
options=('!strip')   # a static Go binary, already stripped at build time

source_x86_64=("remohop_linux_amd64-${pkgver}.tar.gz::https://github.com/@REPO@/releases/download/@TAG@/remohop_linux_amd64.tar.gz")
source_aarch64=("remohop_linux_arm64-${pkgver}.tar.gz::https://github.com/@REPO@/releases/download/@TAG@/remohop_linux_arm64.tar.gz")
sha256sums_x86_64=('@SHA_LINUX_AMD64@')
sha256sums_aarch64=('@SHA_LINUX_ARM64@')

package() {
  install -Dm755 remohop "$pkgdir/usr/bin/remohop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_LICENSES.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES.txt"
}
