# yaml-language-server: $schema=https://aka.ms/winget-manifest.defaultLocale.1.9.0.schema.json
PackageIdentifier: @WINGET_PUBLISHER@.RemoHop
PackageVersion: @VERSION_NOV@
PackageLocale: en-US
Publisher: @WINGET_PUBLISHER_NAME@
PublisherUrl: https://remohop.com/
PublisherSupportUrl: https://github.com/@REPO@/issues
PackageName: RemoHop
PackageUrl: https://github.com/@REPO@
License: AGPL-3.0-only
LicenseUrl: https://github.com/@REPO@/blob/@TAG@/LICENSE
ShortDescription: Lightweight peer-to-peer remote control over an end-to-end encrypted session.
Description: |-
  RemoHop's single binary, remohop, is a command-line client, a host daemon, an optional
  rendezvous server and a browser gateway. It offers shell, file transfer, port forwarding,
  clipboard, screenshots and remote desktop over an end-to-end encrypted session.
Tags:
- remote-access
- remote-control
- p2p
- cli
ReleaseNotesUrl: https://github.com/@REPO@/releases/tag/@TAG@
ManifestType: defaultLocale
ManifestVersion: 1.9.0
