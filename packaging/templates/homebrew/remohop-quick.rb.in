# Homebrew cask for RemoHop quick support (RemoHop.app), generated by scripts/gen-manifests.sh
# from a release. It lives in the same tap as the formula (readori/homebrew-tap), at
# Casks/remohop-quick.rb:
#   brew install --cask readori/tap/remohop-quick
# The token is not "remohop" so that it cannot be confused with the formula (the CLI).
cask "remohop-quick" do
  version "@VERSION_NOV@"
  sha256 "@SHA_MACOS_DMG@"

  url "https://github.com/@REPO@/releases/download/@TAG@/RemoHop-macos.dmg",
      verified: "github.com/@REPO@/"
  name "RemoHop"
  desc "Quick support: share this Mac with someone who is helping you"
  homepage "https://remohop.com/"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :monterey"

  # Signed with a Developer ID, notarized and stapled; Homebrew installs it unchanged.
  app "RemoHop.app"

  # Only the quick-support files: the rest of this directory is the remohop CLI's
  # identity and settings, shared with the formula.
  zap trash: [
    "~/Library/Application Support/remohop/quick.lang",
    "~/Library/Application Support/remohop/quick.log",
    "~/Library/Application Support/remohop/quick.url",
  ]
end
