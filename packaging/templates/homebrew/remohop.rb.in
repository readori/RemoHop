# Homebrew formula for RemoHop, generated by scripts/gen-manifests.sh from a release.
# Tap layout: a repository named homebrew-REPLACE_ME_TAP under REPLACE_ME_OWNER,
# with this file at Formula/remohop.rb. Then:
#   brew install REPLACE_ME_OWNER/REPLACE_ME_TAP/remohop
# Until the release assets are public, brew cannot download them (no credentials).
class Remohop < Formula
  desc "Lightweight peer-to-peer remote control over an end-to-end encrypted session"
  homepage "https://github.com/@REPO@"
  version "@VERSION_NOV@"
  license "AGPL-3.0-only"

  # The macOS binary is one universal (arm64 + x86_64), Developer ID signed and
  # notarized executable. Homebrew must not modify it (that would void the signature).
  on_macos do
    url "https://github.com/@REPO@/releases/download/@TAG@/remohop_darwin_universal.tar.gz"
    sha256 "@SHA_DARWIN_UNIVERSAL@"
  end

  on_linux do
    on_intel do
      url "https://github.com/@REPO@/releases/download/@TAG@/remohop_linux_amd64.tar.gz"
      sha256 "@SHA_LINUX_AMD64@"
    end
    on_arm do
      url "https://github.com/@REPO@/releases/download/@TAG@/remohop_linux_arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
  end

  def install
    bin.install "remohop"
    doc.install "LICENSE", "THIRD_PARTY_LICENSES.txt"
  end

  def caveats
    <<~EOS
      Nothing runs until you start it. To host this machine:
        remohop host
      or, to start it at login:
        remohop service install
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/remohop version")
  end
end
