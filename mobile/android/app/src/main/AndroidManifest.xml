<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- P2P sessions (UDP/QUIC) and the rendezvous server the user sets. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The default network's own addresses, for LAN candidates (see LocalAddresses). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Host sessions stay connected in the background until the user
         disconnects: a foreground service with an ongoing notification
         (SessionService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Host mode (this phone viewed and controlled from other devices,
         HostService): the screen sharing the owner allows for each sharing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Whether a mail app is installed (Diag.email). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".RemoHopApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.RemoHop">

        <!-- No WebView metrics or Safe Browsing lookups: the only page is local. -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />

        <!-- Rotation, keyboard and theme changes resize the WebView instead of
             recreating it, so the page and its sessions stay. singleTop, not
             singleTask: starting the app again (its icon, the session
             notification) must bring the task back as it was, with Settings
             still open on top, rather than clear everything above this. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rotation, resizing and keyboards relayout the pages; a theme or
             font change recreates the activity, which then restores the
             fields (stable IDs) and the pairing in progress (PairJob). -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.RemoHop.Settings"
            android:windowSoftInputMode="adjustResize" />

        <!-- Hands the diagnostic report the user chose to share to the mail or
             share target (res/xml/file_paths.xml: that file only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's remote-control session to their own computer connected while the app is in the background, until the user disconnects from the app or from the ongoing notification." />
        </service>

        <!-- Host mode: "This device" lives in Settings; this is the approval
             dialog for each incoming request (from the app or its notification). -->
        <activity
            android:name=".ApprovalActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.RemoHop.Approval" />

        <!-- Host mode's foreground service: while host mode is on it keeps the
             app reachable for connection requests (specialUse), and while the
             owner shares the screen it holds the MediaProjection
             (mediaProjection, after the owner's consent for that sharing). -->
        <service
            android:name=".HostService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="The user switched on Allow remote connection: the app must stay reachable so that connection requests to this phone reach the user, who approves or denies each one; it stops when the user switches it off from the app or the ongoing notification." />
        </service>

        <!-- Host mode's control: an accessibility service the owner switches on
             in the system settings, acting only during a session the owner
             approved with control (ControlService). -->
        <service
            android:name=".ControlService"
            android:exported="true"
            android:label="@string/hm_ax_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/control_service" />
        </service>
    </application>
</manifest>
