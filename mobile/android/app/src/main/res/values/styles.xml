<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The web page draws the app's top bar; dark status bar icons on it. -->
    <style name="Theme.RemoHop" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/rh_accent</item>
        <item name="android:colorAccent">@color/rh_accent</item>
        <item name="android:windowBackground">@color/rh_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Settings: a flat app bar on the page colour (Material 3 lists). -->
    <style name="Theme.RemoHop.Settings" parent="android:Theme.Material.Light">
        <item name="android:colorPrimary">@color/rh_bg</item>
        <item name="android:colorPrimaryDark">@color/rh_bg</item>
        <item name="android:colorAccent">@color/rh_accent</item>
        <item name="android:windowBackground">@color/rh_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
