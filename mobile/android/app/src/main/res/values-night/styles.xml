<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RemoHop" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/md_primary</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:windowBackground">@color/rh_bg</item>
        <!-- Edge to edge on every version (Android 15+ enforces it): the bars
             are transparent over the page colour (BarsBackground). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
