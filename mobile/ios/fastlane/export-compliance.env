# Export compliance answer for the RemoHop iOS build. The OWNER sets this; CI never guesses.
#   USES_NON_EXEMPT_ENCRYPTION=        (empty: not answered; answer it in App Store Connect per build)
#   USES_NON_EXEMPT_ENCRYPTION=NO      (CI builds with ITSAppUsesNonExemptEncryption = NO)
#   USES_NON_EXEMPT_ENCRYPTION=YES     (CI builds with ITSAppUsesNonExemptEncryption = YES; Apple then also
#                                       asks for documentation / a compliance code in App Store Connect)
USES_NON_EXEMPT_ENCRYPTION=
